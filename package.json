{
  "name": "turbo-astro-hono",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:peers": "pnpm peers check",
    "dev": "turbo run dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,html,css,md,mdx,astro,json,mjs,yml,yaml}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,html,css,md,mdx,astro,json,mjs,yml,yaml}\"",
    "verify:fast": "pnpm check:peers && pnpm check:architecture && pnpm lint && pnpm test",
    "verify": "pnpm format:check && pnpm verify:fast && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "turbo": "^2.10.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@12.4.2"
}
